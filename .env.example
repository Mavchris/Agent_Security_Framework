# Agent Security Intelligence Framework - Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local
# 2. Edit .env.local with your actual values
# 3. NEVER commit .env.local to Git (already in .gitignore)
# 4. Restart framework after changes for env vars to take effect
#
# SECURITY NOTE:
# This file contains sensitive information (API keys, secrets).
# Keep .env.local private and never share it.
#
# Last Updated: March 28, 2026
# Framework Version: 2.0

################################################################################
# THREAT INTELLIGENCE SOURCES (CTI)
################################################################################

# Censys API Credentials
# Purpose: Collect internet exposure data and vulnerability information
# Get API credentials:
#   1. Go to https://censys.io
#   2. Sign up (free account)
#   3. Go to Account Settings → API
#   4. Copy API ID and Secret
# Status: Optional (framework works with 6/7 sources without it)
# Note: Without Censys, you miss ~25 threats from internet scan data
#
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# Alternative: If you have Censys API credentials, format should be:
# CENSYS_API_ID=f1234567-89ab-cdef-0123-456789abcdef
# CENSYS_API_SECRET=0123456789abcdef0123456789abcdef01234567

################################################################################
# LLM INTEGRATIONS - AGENT TESTING
################################################################################

# Anthropic Claude API Key
# Purpose: Test vulnerability scanning with Claude agent
# Get API key:
#   1. Go to https://console.anthropic.com
#   2. Sign in or create account
#   3. Go to API Keys
#   4. Create new API key
#   5. Copy the full key (starts with sk-ant-v4-)
# Status: Optional (can test with MockAgent or other agents)
# Note: Claude is premium, costs $3-15 per 1M tokens
# Cost for testing all 219 threats: ~$1-3
#
ANTHROPIC_API_KEY=sk-ant-v4-your_anthropic_api_key_here

# Example format:
# ANTHROPIC_API_KEY=sk-ant-v4-d5c98b3e7f2a9c1e4b6d8a0f3e5c7b9a

################################################################################

# OpenAI GPT-4 API Key
# Purpose: Test vulnerability scanning with GPT-4 agent
# Get API key:
#   1. Go to https://platform.openai.com
#   2. Sign in or create account
#   3. Go to API Keys (https://platform.openai.com/api-keys)
#   4. Create new secret key
#   5. Copy the full key (starts with sk-proj-)
# Status: Optional (can test with other agents)
# Note: GPT-4 is expensive, costs $0.03-0.06 per 1K tokens
# Cost for testing all 219 threats: ~$5-10
#
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Example format:
# OPENAI_API_KEY=sk-proj-abc123def456ghi789jkl012mno345pqr678stu

################################################################################

# Local LLM via Ollama (FREE - NO API KEY NEEDED)
# Purpose: Test vulnerability scanning with local LLM (Mistral)
# Requirements:
#   1. Install Ollama from https://ollama.ai
#   2. Pull model: ollama pull mistral
#   3. Start server: ollama serve (in separate terminal)
#   4. Framework will auto-connect to http://localhost:11434
# Status: Optional but recommended (free, no costs)
# Note: Requires 8GB+ RAM, takes 10-15 min to test all threats
#
# No API key needed! Framework auto-detects Ollama on localhost:11434
# To use different host/port, edit testing/agent_wrappers.py

################################################################################

# Hugging Face Hub Token (Optional - for HF models)
# Purpose: Access gated models on Hugging Face Hub
# Get token:
#   1. Go to https://huggingface.co/settings/tokens
#   2. Create new token (read permission OK)
#   3. Copy the full token
# Status: Optional (only if using private HF models)
#
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# Example format:
# HUGGINGFACE_API_KEY=hf_abcdefghijklmnopqrstuvwxyz1234567890

################################################################################
# DATABASE CONFIGURATION
################################################################################

# SQLite Database Path
# Purpose: Store threat data and metadata
# Default: data/threats.db (relative to project root)
# Status: Recommended to keep default
# Note: Database auto-created on first run
# You can change to absolute path if needed
#
DATABASE_URL=../data/threats.db

# Alternative paths:
# DATABASE_URL=data/threats.db              (relative)
# DATABASE_URL=/home/user/threats.db        (absolute Linux/macOS)
# DATABASE_URL=C:\Users\user\threats.db     (absolute Windows)

################################################################################
# LOGGING CONFIGURATION
################################################################################

# Log Level
# Purpose: Control verbosity of framework logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# Recommendations:
#   - DEBUG: Very verbose, shows all operations (for debugging)
#   - INFO: Normal operation, shows key events (recommended)
#   - WARNING: Only show warnings and errors
#   - ERROR: Only show errors
#   - CRITICAL: Only show critical issues
# Status: Optional (defaults to INFO if not set)
#
LOG_LEVEL=INFO

# Log File Location
# Purpose: Where to save application logs
# Default: logs/orchestrator.log
# Status: Optional
#
LOG_FILE=logs/orchestrator.log

################################################################################
# ORCHESTRATOR SCHEDULING
################################################################################

# Enable/Disable Scheduler
# Purpose: Control whether APScheduler starts automatically
# Options: true, false
# Default: true
# Recommendations:
#   - true: Framework runs automated pipeline
#   - false: Framework runs in manual mode only (for debugging)
# Status: Optional
#
SCHEDULER_ENABLED=true

# Scheduler Timezone
# Purpose: Control timezone for scheduled tasks
# Default: UTC
# Options: 
#   - UTC (recommended, uses UTC timestamps)
#   - America/New_York, America/Los_Angeles, etc.
#   - Europe/London, Europe/Paris, etc.
#   - Asia/Tokyo, Asia/Shanghai, etc.
# Current schedule (UTC):
#   - Daily: 02:00 UTC (collect threats)
#   - Weekly: Monday 10:00 UTC (validate, deduplicate, report)
#   - Hourly: Health checks
# Status: Optional
#
SCHEDULER_TIMEZONE=UTC

# Examples for other timezones:
# SCHEDULER_TIMEZONE=America/New_York      (EST/EDT)
# SCHEDULER_TIMEZONE=Europe/Paris          (CET/CEST)
# SCHEDULER_TIMEZONE=Asia/Tokyo            (JST)
# SCHEDULER_TIMEZONE=Australia/Sydney      (AEDT/AEST)

################################################################################
# DASHBOARD CONFIGURATION
################################################################################

# Streamlit Server Port
# Purpose: Port for Streamlit dashboards
# Default: 8501
# Status: Optional (only if you want different port)
# Use if: Port 8501 already in use
#
# STREAMLIT_SERVER_PORT=8501

# Streamlit Headless Mode
# Purpose: Run without opening browser
# Options: true, false
# Default: false
#
# STREAMLIT_SERVER_HEADLESS=false

# API Server Port
# Purpose: Port for FastAPI REST API
# Default: 8000
# Status: Optional (only if you want different port)
# Use if: Port 8000 already in use
#
# API_PORT=8000

################################################################################
# DATA COLLECTION CONFIGURATION
################################################################################

# Number of Threats to Collect (per source)
# Purpose: Limit how many items to collect from each CTI source
# Default: Unlimited (all available)
# Status: Optional (set to test with smaller dataset)
# Examples:
#   - 50: Collect only 50 items per source (for testing)
#   - 0: Unlimited (default)
#
# CTI_LIMIT_PER_SOURCE=0

# Data Retention Days
# Purpose: How long to keep threat data in database
# Default: 365 (keep 1 year of data)
# Status: Optional
#
# DATA_RETENTION_DAYS=365

# Deduplication
# Purpose: Remove duplicate threats from database
# Options: true, false
# Default: true (recommended)
# Status: Optional
#
# DEDUPLICATION_ENABLED=true

################################################################################
# MONITORING & ALERTS (FUTURE)
################################################################################

# These features are planned for v2.1
# Uncomment when available

# Email Alerts
# Purpose: Send security alerts via email
# Status: Planned for v2.1
# ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_FROM=security@example.com
# ALERT_EMAIL_TO=admin@example.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Slack Alerts
# Purpose: Send security alerts to Slack
# Status: Planned for v2.1
# SLACK_ALERT_ENABLED=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_CHANNEL=#security-alerts

# PagerDuty Integration
# Purpose: Create PagerDuty incidents for critical threats
# Status: Planned for v2.1
# PAGERDUTY_ENABLED=false
# PAGERDUTY_API_KEY=your_pagerduty_api_key
# PAGERDUTY_SERVICE_ID=your_service_id

################################################################################
# SECURITY CONFIGURATION
################################################################################

# Secret Key (for future authentication)
# Purpose: Encrypt sessions and tokens
# Status: Placeholder for future authentication system
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# SECRET_KEY=your_generated_secret_key_here

# Authentication Enabled
# Purpose: Enable/disable user authentication
# Options: true, false
# Default: false (not yet implemented)
# Status: Planned for v2.0
#
# AUTH_ENABLED=false

################################################################################
# ADVANCED CONFIGURATION
################################################################################

# Debug Mode
# Purpose: Enable extra debugging output
# Options: true, false
# Default: false
# Status: Optional (for troubleshooting)
# Note: Can be verbose, affects performance
#
DEBUG_MODE=false

# Worker Threads
# Purpose: Number of threads for parallel processing
# Default: 4
# Status: Optional
# Recommendations:
#   - 2: Single-core CPUs
#   - 4: Dual-core CPUs (default)
#   - 8: Quad-core CPUs
#   - 16: High-end servers
#
# WORKER_THREADS=4

# Connection Pool Size
# Purpose: Database connection pool size
# Default: 5
# Status: Optional
#
# DB_POOL_SIZE=5

# Request Timeout (seconds)
# Purpose: HTTP request timeout for CTI sources
# Default: 30 seconds
# Status: Optional
#
# REQUEST_TIMEOUT=30

# Retry Attempts
# Purpose: Number of retries for failed requests
# Default: 3
# Status: Optional
#
# RETRY_ATTEMPTS=3

# Retry Delay (seconds)
# Purpose: Delay between retries
# Default: 5
# Status: Optional
#
# RETRY_DELAY=5

################################################################################
# RESEARCH & ACADEMIC CONFIGURATION
################################################################################

# Research Mode
# Purpose: Enable features for academic research
# Options: true, false
# Default: false
# Status: Optional
# Features when enabled:
#   - Extra metrics collection
#   - Detailed threat data export
#   - Validation reports
#
# RESEARCH_MODE=false

# Academic Dataset Export
# Purpose: Export data in academic formats
# Options: true, false
# Default: false
#
# ACADEMIC_EXPORT=false

################################################################################
# DEPLOYMENT CONFIGURATION
################################################################################

# Environment Type
# Purpose: Identify deployment environment
# Options: development, staging, production
# Default: development
# Status: Optional
#
ENVIRONMENT=development

# Examples:
# ENVIRONMENT=development    (local testing)
# ENVIRONMENT=staging        (pre-production)
# ENVIRONMENT=production     (live deployment)

# Allow External Access
# Purpose: Allow connections from other machines
# Options: true, false
# Default: false (localhost only)
# Status: Optional (set true for Docker/K8s)
#
# ALLOW_EXTERNAL=false

# CORS Enabled
# Purpose: Enable Cross-Origin Resource Sharing (for frontend)
# Options: true, false
# Default: false
# Status: Optional
#
# CORS_ENABLED=false

# CORS Origins
# Purpose: Allowed CORS origins
# Default: http://localhost:3000
# Status: Optional (if CORS_ENABLED=true)
#
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

################################################################################
# NOTES FOR USERS
################################################################################

# DO's:
# ✓ Copy this file: cp .env.example .env.local
# ✓ Edit .env.local with your values
# ✓ Keep .env.local private (don't commit to Git)
# ✓ Restart framework after changes
# ✓ Use strong, unique API keys
# ✓ Rotate API keys regularly
# ✓ Monitor API usage and costs

# DON'Ts:
# ✗ Don't commit .env.local to Git
# ✗ Don't share API keys via email/chat
# ✗ Don't use placeholder values in production
# ✗ Don't leave default passwords/secrets
# ✗ Don't store API keys in code
# ✗ Don't use same API key across environments
# ✗ Don't check in backups of .env files

# Getting Started:
# 1. cp config/.env.example config/.env.local
# 2. nano config/.env.local  (or edit in your editor)
# 3. Add your API keys (optional)
# 4. Save and exit
# 5. Restart framework: streamlit run dashboard/main.py

# Minimal Setup (framework still works):
# - No API keys needed!
# - Default database and logging work
# - Scheduler enabled by default
# - 6/7 CTI sources work without Censys

# Full Setup (all features):
# - CENSYS_API_ID & CENSYS_API_SECRET (internet scan data)
# - ANTHROPIC_API_KEY (Claude agent testing)
# - OPENAI_API_KEY (GPT-4 agent testing)
# - Ollama installed locally (Mistral agent testing - FREE)

# Support:
# - GitHub Issues: https://github.com/Mavchris/Agent_Security_Framework/issues
# - GitHub Discussions: https://github.com/Mavchris/Agent_Security_Framework/discussions
# - Documentation: See docs/ folder

